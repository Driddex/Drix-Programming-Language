{
  "scopeName": "source.dr",
  "patterns": [
    {
      "name": "keyword.control.dr",
      "match": "\\b(dr|drnum|Output|if|else|Func)\\b"
    },
    {
      "name": "string.quoted.double.dr",
      "match": "\".*?\""
    },
    {
      "name": "constant.numeric.dr",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "entity.name.function.dr",
      "match": "\\b(Ignore|Input|AutoPut|Stop)\\b"
    },
    {
      "name": "comment.line.double-pipe.dr",
      "match": "\\|\\|.*$"
    }
  ]
}
