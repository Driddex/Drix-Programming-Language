{
  "Create Number Variable": {
    "prefix": "drnum",
    "body": ["drnum ${1:name} = ${2:0};"],
    "description": "Create Number Variable"
  },
  "Create String Variable": {
    "prefix": "dr",
    "body": ["dr ${1:name} = \"${2:text}\";"],
    "description": "Create Text Variable"
  },
  "Print Output": {
    "prefix": "Output",
    "body": ["Output ${1:value};"],
    "description": "Output (Value)"
  },
  "AutoPut Outputer": {
    "prefix": "AutoPut",
    "body": ["AutoPut;"],
    "description": "AutoPut Test Val"
  },
  "Ignore Next Line": {
    "prefix": "Ignore",
    "body": ["Ignore ${1:text};"],
    "description": "Ignore The next line"
  },
  "if": {
    "prefix": "if",
    "body": ["if (...) {\n\n};"],
    "description": "If"
  },
    "else": {
    "prefix": "else",
    "body": ["else{\n\n}"],
    "description": "else"
  },
    "Input Variable": {
    "prefix": "Input",
    "body": ["Input ${1:dr}"],
    "description": "Input Function"
  },
    "Stop": {
    "prefix": "Stop",
    "body": ["Stop;"],
    "description": "Stop the entire code"
  },
    "Function": {
    "prefix": "Func",
    "body": ["Func name(){\n\n};"],
    "description": "Use The Function System"
  },
    "use": {
    "prefix": "use",
    "body": ["use <>;"],
    "description": "Use The Libraries"
  }
}
